# CIPHER Environment Configuration
# Local-First & Privacy Settings
LOCAL_ONLY=true
ALLOW_NETWORK_ACCESS=false

# REST API Server Binding
API_HOST=127.0.0.1
API_PORT=8000

# SQLite Local Database File
DATABASE_PATH=cipher.db

# Machine Learning Artifact Paths (relative to backend/)
MODEL_PATH=models/phishing/phishing_model.joblib
PIPELINE_PATH=models/phishing/feature_pipeline.joblib
NETWORK_MODEL_PATH=models/network/network_ids_model.joblib
NETWORK_PIPELINE_PATH=models/network/network_feature_pipeline.joblib

# Heuristic & Scoring Weights (must sum to 1.0)
ML_WEIGHT=0.70
HEURISTIC_WEIGHT=0.30

# IPS Defensive Prevention Mode: detect_only (default/safe), simulate, enforce
CIPHER_PREVENTION_MODE=detect_only
AUTO_BLOCK_THRESHOLD=80
DEFAULT_TEMP_BLOCK_MINUTES=60
