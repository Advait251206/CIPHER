# CIPHER Environment Configuration (copy to backend/.env)

# REST API binding. Keep 127.0.0.1: the API controls the host firewall in enforce mode.
API_HOST=127.0.0.1
API_PORT=8000

# API token for state-changing requests (X-CIPHER-Token header).
# Leave empty to auto-generate one in backend/.cipher_token on first start.
CIPHER_API_TOKEN=
# Extra browser origins allowed to call the API (comma-separated). The dashboard
# (http://localhost:5173) and browser extensions are always allowed.
CIPHER_ALLOWED_ORIGINS=

# SQLite database file (relative to backend/)
DATABASE_PATH=cipher.db

# Machine Learning artifact paths (relative to backend/)
MODEL_PATH=models/phishing/phishing_model.joblib
PIPELINE_PATH=models/phishing/feature_pipeline.joblib

# Threat scoring weights (must sum to 1.0)
ML_WEIGHT=0.70
HEURISTIC_WEIGHT=0.30

# Prevention mode: detect_only (default, safe) | simulate | enforce
# Missing or invalid values fall back to detect_only. Only enforce creates Windows firewall rules.
CIPHER_PREVENTION_MODE=detect_only
DEFAULT_TEMP_BLOCK_MINUTES=60
# Addresses/CIDRs that must never be blocked (gateway, DNS, admin hosts), comma-separated.
# Loopback, link-local, multicast and this host's own addresses are always protected.
CIPHER_PROTECTED_IPS=
# Auto-create a threat-intel IOC for every enforced block (off: one false positive would
# otherwise give that address a permanent high-severity score floor).
CIPHER_AUTO_THREAT_INTEL_FROM_BLOCKS=false

# Live sensor
# Optional port allow-list; empty = track all ports (needed for port-scan detection).
CIPHER_MONITORED_PORTS=
# Ports whose plaintext HTTP requests the WAF inspects (CIPHER's own API is excluded on purpose).
CIPHER_WAF_PORTS=5174,8080
# Source addresses/CIDRs whose DoS/DDoS verdicts are suppressed (e.g. a known load tester). Empty by default.
CIPHER_TRUSTED_SOURCES=
