{
  "name": "cipher-soc-platform",
  "version": "1.0.0",
  "private": true,
  "description": "CIPHER — Cyber Intrusion Prevention & Heuristic Event Response",
  "scripts": {
    "dev": "concurrently --kill-others --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python -c \"import subprocess, sys; sys.exit(subprocess.call([sys.executable, '-m', 'pytest', 'tests'], cwd='backend'))\"",
    "test:frontend": "npm --prefix frontend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
